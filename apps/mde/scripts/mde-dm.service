[Unit]
Description=Magnetar Display Manager
After=systemd-user-sessions.service
Conflicts=getty@tty1.service display-manager.service
Wants=graphical.target

[Service]
Type=simple
ExecStart=/usr/lib/mde/mde-display-manager --session=/usr/lib/mde/mde-session --greeter=/usr/lib/mde/mde-greeter
Restart=always
RestartSec=2
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
