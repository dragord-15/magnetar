fn main() {
    int a = 17;
    print(a + 3); print(" ");
    print(a - 5); print(" ");
    print(a * 2); print(" ");
    print(a / 4); print(" ");
    print(a % 4); print(" ");
    print(a & 3); print(" ");
    print(a | 8); print(" ");
    print(a ^ 3); print(" ");
    if (a > 10) { print("gt"); } else { print("le"); }
    print("\n");
}
